---
import { site, profile } from '@/lib/data';
import Icon from '@/components/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/blog') && path.startsWith('/blog');
const firstName = profile.name.split(' ')[0].toLowerCase();
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled=true]:border-border data-[scrolled=true]:bg-bg/80 data-[scrolled=true]:backdrop-blur-xl"
>
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="group flex items-center gap-2 font-mono text-sm font-medium" aria-label="Home">
      <span
        class="grid size-8 place-items-center rounded-lg border border-border bg-surface text-accent transition-colors group-hover:border-accent/50"
      >
        <Icon name="lucide:terminal" class="size-4" />
      </span>
      <span class="hidden sm:inline">
        <span class="text-accent">{firstName}</span><span class="text-muted">@sec:~$</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-sm transition-colors hover:text-fg',
                isActive(item.href) ? 'text-accent' : 'text-muted',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        id="menu-button"
        type="button"
        class="grid size-9 place-items-center rounded-lg border border-border bg-surface md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-open"><Icon name="lucide:menu" class="size-4" /></span>
        <span class="menu-close hidden"><Icon name="lucide:x" class="size-4" /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-border bg-bg/95 backdrop-blur-xl md:hidden">
    <ul class="container-page flex flex-col py-3">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-md px-2 py-3 font-mono text-sm text-muted hover:text-accent">
              <span class="text-accent">~/</span>
              {item.label.toLowerCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('mobile-menu')!;
  let open = false;

  const sync = () => header.setAttribute('data-scrolled', String(window.scrollY > 8 || open));
  window.addEventListener('scroll', sync, { passive: true });
  sync();

  function setOpen(value: boolean) {
    open = value;
    menu.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    button.querySelector('.menu-open')?.classList.toggle('hidden', open);
    button.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    sync();
  }
  button.addEventListener('click', () => setOpen(!open));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
