---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, profile } from '@/lib/data';
import { resolveAsset } from '@/lib/images';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  image,
  imageAlt,
  type = 'website',
  published,
  modified,
  tags = [],
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.title}` : `${site.title} · ${profile.roles.join(' | ')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image ?? resolveAsset(profile.photo), width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.roles[0],
  url: Astro.site?.toString(),
  address: profile.location,
  sameAs: profile.contact.socials.filter((s) => s.url).map((s) => s.url),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.title} · ${site.blog.title}`} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#07090b" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f9f8" media="(prefers-color-scheme: light)" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={site.locale.replace('-', '_')} />
<meta property="og:title" content={title ?? site.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:alt" content={imageAlt ?? profile.name} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? personLd)} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
/>

<!-- Apply the saved theme before first paint to avoid a flash. -->
<script is:inline>
  (() => {
    let pref = 'system';
    try {
      pref = localStorage.getItem('theme') || 'system';
    } catch {}
    const dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
    const root = document.documentElement;
    root.classList.toggle('dark', dark);
    root.dataset.themePref = pref;
    root.classList.remove('no-js');
  })();
</script>
