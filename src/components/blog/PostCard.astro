---
import type { Post } from '@/lib/blog';
import { formatDate, tagSlug } from '@/lib/blog';
import Icon from '@/components/Icon.astro';

interface Props {
  post: Post;
  variant?: 'card' | 'row';
}

const { post, variant = 'card' } = Astro.props;
const href = `/blog/${post.slug}/`;
---

{
  variant === 'card' ? (
    <article class="card group relative flex h-full flex-col p-6 transition-colors hover:border-accent/50">
      <div class="flex items-center gap-3 font-mono text-xs text-muted">
        <time datetime={post.date.toISOString()}>{formatDate(post.date, 'short')}</time>
        <span aria-hidden="true">·</span>
        <span>{post.minutes} min read</span>
        {post.draft && <span class="rounded bg-amber-500/15 px-1.5 text-amber-500">draft</span>}
      </div>
      <h3 class="mt-3 text-lg font-semibold text-balance transition-colors group-hover:text-accent">
        <a href={href} class="after:absolute after:inset-0">
          {post.title}
        </a>
      </h3>
      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{post.description}</p>
      {post.tags.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-2 pt-5 font-mono text-[11px] text-accent">
          {post.tags.slice(0, 4).map((tag) => (
            <li>#{tagSlug(tag)}</li>
          ))}
        </ul>
      )}
    </article>
  ) : (
    <article class="group relative grid gap-2 border-b border-border py-7 sm:grid-cols-[9rem_1fr] sm:gap-8">
      <div class="font-mono text-xs text-muted sm:pt-1.5">
        <time datetime={post.date.toISOString()}>{formatDate(post.date, 'short')}</time>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-balance transition-colors group-hover:text-accent">
          <a href={href} class="after:absolute after:inset-0">
            {post.title}
          </a>
          {post.draft && (
            <span class="ml-2 rounded bg-amber-500/15 px-1.5 align-middle font-mono text-xs text-amber-500">draft</span>
          )}
        </h2>
        <p class="mt-2 leading-relaxed text-muted">{post.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:clock" class="size-3.5" />
            {post.minutes} min read
          </span>
          {post.tags.length > 0 && (
            <ul class="relative z-10 flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <li>
                  <a href={`/blog/tags/${tagSlug(tag)}/`} class="text-accent hover:underline">
                    #{tagSlug(tag)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </article>
  )
}
