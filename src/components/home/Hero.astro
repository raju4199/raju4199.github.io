---
import { getImage } from 'astro:assets';
import { profile, timeline, site } from '@/lib/data';
import { resolveAsset } from '@/lib/images';
import Icon from '@/components/Icon.astro';
import HeroBackdrop from '@/components/react/HeroBackdrop';
import HeroCard from '@/components/react/HeroCard';
import DecryptedText from '@/components/reactbits/DecryptedText';

const photo = await getImage({ src: resolveAsset(profile.photo), width: 760, format: 'webp', quality: 82 });
const current = [...timeline].reverse().find((t) => t.type === 'work' && t.end === 'present');
const socials = profile.contact.socials.filter((s) => s.url);
const showContact = site.home.includes('contact');
---

<section id="top" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-28 pb-16">
  <div
    class="absolute inset-0 -z-20 opacity-50 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_45%,black_10%,transparent_80%)] dark:opacity-40"
  >
    <HeroBackdrop client:idle />
  </div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_50%_45%_at_30%_45%,var(--bg)_20%,transparent_100%)] opacity-90"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-bg"></div>

  <div class="container-page grid items-center gap-14 lg:grid-cols-[1.25fr_1fr]">
    <div class="min-w-0">
      <p class="font-mono text-sm text-muted">
        <span class="text-accent">$</span> whoami
      </p>
      <h1 class="mt-4 text-5xl font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        {profile.name}
      </h1>

      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-base text-accent sm:text-lg">
        {
          profile.roles.map((role, i) => (
            <>
              {i > 0 && <span class="text-muted/60" aria-hidden="true">|</span>}
              <DecryptedText
                client:visible
                text={role}
                animateOn="view"
                sequential
                speed={40}
                revealDirection="start"
                characters="01ABCDEF#$%&*<>/"
                encryptedClassName="text-muted"
              />
            </>
          ))
        }
      </p>

      <p class="mt-6 max-w-xl text-lg text-muted text-pretty">{profile.tagline}</p>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm text-muted">
        {
          current && (
            <li class="flex items-center gap-2">
              <span class="relative flex size-2">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60" />
                <span class="relative inline-flex size-2 rounded-full bg-accent" />
              </span>
              {current.title}
              {current.org && ` @ ${current.org}`}
            </li>
          )
        }
        {
          profile.location && (
            <li class="flex items-center gap-2">
              <Icon name="lucide:map-pin" class="size-4 text-accent" />
              {profile.location}
            </li>
          )
        }
      </ul>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-fg shadow-[0_0_30px_-8px_var(--accent)] transition hover:brightness-110"
        >
          <Icon name="lucide:book-open" class="size-4" />
          Read the blog
        </a>
        {
          showContact && (
            <a
              href="#contact"
              class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface/70 px-5 py-3 text-sm font-semibold backdrop-blur transition hover:border-accent/50 hover:text-accent"
            >
              <Icon name="lucide:send" class="size-4" />
              Get in touch
            </a>
          )
        }
        <ul class="ml-1 flex items-center gap-1">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer me"
                  class="grid size-10 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-accent"
                  aria-label={s.label}
                  title={s.label}
                >
                  <Icon name={s.icon} class="size-[18px]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hero-card flex min-w-0 justify-center lg:justify-end">
      <HeroCard
        client:visible
        photo={photo.src}
        name={profile.name}
      />
    </div>
  </div>

  <a
    href="#main-content"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 font-mono text-[11px] text-muted transition-colors hover:text-accent sm:flex"
    aria-label="Scroll to content"
  >
    scroll
    <Icon name="lucide:chevron-down" class="size-4 animate-bounce" />
  </a>
</section>
<div id="main-content"></div>

<style is:global>
  /* ProfileCard sizes itself by height; keep it inside narrow viewports. */
  .hero-card section {
    max-height: min(540px, calc((100vw - 2rem) / 0.718)) !important;
  }
</style>
