---
import { projects } from '@/lib/data';
import Section from './Section.astro';
import Icon from '@/components/Icon.astro';
import SpotlightCard from '@/components/reactbits/SpotlightCard';

interface Props {
  index?: number;
}

const STATUS = {
  shipped: { label: 'Shipped', class: 'bg-accent-soft text-accent' },
  'in-progress': { label: 'In progress', class: 'bg-accent-2/10 text-accent-2' },
  'coming-soon': { label: 'Coming soon', class: 'bg-surface-2 text-muted' },
} as const;

const LINKS = [
  { key: 'github', label: 'Source', icon: 'simple-icons:github' },
  { key: 'demo', label: 'Demo', icon: 'lucide:external-link' },
  { key: 'writeup', label: 'Write-up', icon: 'lucide:file-text' },
] as const;
---

<Section id="projects" index={Astro.props.index}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <SpotlightCard
          client:visible
          className={`flex h-full flex-col ${project.status === 'coming-soon' ? 'border-dashed' : ''}`}
        >
          <div class="flex items-start justify-between gap-3">
            <span class="grid size-10 place-items-center rounded-lg bg-accent-soft text-accent">
              <Icon name="lucide:folder-git-2" class="size-5" />
            </span>
            <span class:list={['rounded-full px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wider uppercase', STATUS[project.status].class]}>
              {STATUS[project.status].label}
            </span>
          </div>
          <h3 class="mt-5 text-lg font-semibold">{project.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{project.description}</p>
          {project.tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <li class="font-mono text-[11px] text-accent">#{tag.toLowerCase().replace(/\s+/g, '-')}</li>
              ))}
            </ul>
          )}
          <div class="mt-auto flex gap-4 pt-5 text-sm">
            {LINKS.filter((l) => project.links[l.key]).map((l) => (
              <a
                href={project.links[l.key]}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-accent"
              >
                <Icon name={l.icon} class="size-4" />
                {l.label}
              </a>
            ))}
          </div>
        </SpotlightCard>
      ))
    }
  </div>
</Section>
