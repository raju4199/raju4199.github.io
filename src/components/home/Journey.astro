---
import { timeline, site, formatRange, type TimelineType } from '@/lib/data';
import Section from './Section.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';

interface Props {
  index?: number;
}

const TYPES: Record<TimelineType, { label: string; icon: string }> = {
  education: { label: 'Education', icon: 'lucide:graduation-cap' },
  project: { label: 'Project', icon: 'lucide:code-xml' },
  achievement: { label: 'Achievement', icon: 'lucide:trophy' },
  research: { label: 'Research', icon: 'lucide:book-open' },
  certification: { label: 'Certification', icon: 'lucide:badge-check' },
  work: { label: 'Work', icon: 'lucide:briefcase' },
};

const usedTypes = [...new Set(timeline.map((t) => t.type))];
const showNext = site.home.includes('next');
---

<Section id="journey" index={Astro.props.index}>
  <ul class="mb-10 flex flex-wrap gap-2" aria-label="Legend">
    {
      usedTypes.map((type) => (
        <li class="flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted">
          <Icon name={TYPES[type].icon} class="size-3.5 text-accent" />
          {TYPES[type].label}
        </li>
      ))
    }
  </ul>

  <!-- Single rail on mobile; alternating sides around a centre rail on large screens. -->
  <ol class="relative ml-4 before:absolute before:top-2 before:bottom-2 before:left-0 before:w-px before:bg-gradient-to-b before:from-border before:via-border before:to-accent/60 sm:ml-6 lg:ml-0 lg:before:left-1/2">
    {
      timeline.map((item, i) => {
        const isCurrent = item.end === 'present';
        const left = i % 2 === 0;
        return (
          <li class:list={['group relative pb-8 pl-8 sm:pl-12 lg:w-1/2 lg:pl-0 lg:not-first:-mt-24', left ? 'lg:pr-12' : 'lg:ml-auto lg:pl-12']}>
            <span
              class:list={[
                'absolute top-5 -left-4 z-10 grid size-8 place-items-center rounded-full border bg-bg transition-colors',
                left ? 'lg:right-0 lg:left-auto lg:translate-x-1/2' : 'lg:-translate-x-1/2 lg:left-0',
                isCurrent
                  ? 'border-accent text-accent shadow-[0_0_20px_-4px_var(--accent)]'
                  : 'border-border text-muted group-hover:border-accent/60 group-hover:text-accent',
              ]}
            >
              <Icon name={TYPES[item.type].icon} class="size-4" />
            </span>
            <div class:list={['card p-5 transition-colors group-hover:border-accent/40', isCurrent && 'border-accent/40']}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
                <time class="text-accent">{formatRange(item.start, item.end)}</time>
                <span class="text-muted">· {TYPES[item.type].label}</span>
                {isCurrent && (
                  <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-semibold tracking-wider text-accent uppercase">
                    Now
                  </span>
                )}
              </div>
              {item.logo && (
                <div class="mt-3">
                  <Logo src={item.logo} alt={item.org ?? item.title} class="h-7" />
                </div>
              )}
              <h3 class="mt-2 text-lg font-semibold">
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              {item.org && <p class="text-sm font-medium text-muted">{item.org}</p>}
              {item.description && <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>}
            </div>
          </li>
        );
      })
    }
    {
      showNext && (
        <li class:list={['relative pl-8 sm:pl-12 lg:w-1/2 lg:pl-0', timeline.length % 2 === 0 ? 'lg:pr-12 lg:text-right' : 'lg:ml-auto lg:pl-12']}>
          <span class:list={['absolute top-0 -left-4 z-10 grid size-8 place-items-center rounded-full border border-dashed border-accent/60 bg-bg text-accent', timeline.length % 2 === 0 ? 'lg:right-0 lg:left-auto lg:translate-x-1/2' : 'lg:left-0 lg:-translate-x-1/2']}>
            <Icon name="lucide:rocket" class="size-4" />
          </span>
          <p class="font-mono text-xs text-accent">Next</p>
          <a href="#next" class="mt-1 inline-flex items-center gap-1 text-lg font-semibold hover:text-accent">
            What's next
            <Icon name="lucide:arrow-down" class="size-4" />
          </a>
        </li>
      )
    }
  </ol>
</Section>
