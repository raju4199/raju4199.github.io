---
import { skills } from '@/lib/data';
import Section from './Section.astro';
import Icon from '@/components/Icon.astro';
import SpotlightCard from '@/components/reactbits/SpotlightCard';

interface Props {
  index?: number;
}
---

<Section id="skills" index={Astro.props.index}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((skill) => (
        <SpotlightCard client:visible className="h-full">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-lg bg-accent-soft text-accent">
              <Icon name={skill.icon} class="size-5" />
            </span>
            <h3 class="font-semibold">{skill.name}</h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted">{skill.description}</p>
          {skill.areas.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {skill.areas.map((area) => (
                <li class="rounded-md border border-border bg-surface-2 px-2 py-1 font-mono text-[11px] text-muted">
                  {area}
                </li>
              ))}
            </ul>
          )}
          {skill.tools.length > 0 && (
            <p class="mt-4 font-mono text-xs text-muted">
              <span class="text-accent">tools:</span> {skill.tools.join(' · ')}
            </p>
          )}
        </SpotlightCard>
      ))
    }
  </div>
</Section>
