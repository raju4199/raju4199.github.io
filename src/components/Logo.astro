---
/**
 * Renders a logo from src/assets/ (as named in a data file).
 * SVGs are inlined so `currentColor` follows the theme; raster images are
 * optimized and shown on a white chip so white-background logos look intentional.
 */
import { Image } from 'astro:assets';
import { resolveAsset } from '@/lib/images';

interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className = 'h-5' } = Astro.props;
const svgs = import.meta.glob<string>('/src/assets/**/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = src.endsWith('.svg') ? svgs[`/src/assets/${src}`] : undefined;
if (src.endsWith('.svg') && !raw) throw new Error(`Logo "${src}" not found in src/assets/.`);

const svg = raw
  ?.replace(/<svg([^>]*?)\swidth="[^"]*"/, '<svg$1')
  .replace(/<svg([^>]*?)\sheight="[^"]*"/, '<svg$1')
  .replace('<svg', `<svg role="img" aria-label="${alt}" class="${className} w-auto"`);
---

{
  svg ? (
    <span class="inline-flex text-fg" set:html={svg} />
  ) : (
    <span class="inline-flex rounded-md bg-white px-1.5 py-1 ring-1 ring-border">
      <Image src={resolveAsset(src)} alt={alt} class:list={[className, 'w-auto']} />
    </span>
  )
}
