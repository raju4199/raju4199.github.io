---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogHeader from '@/components/blog/BlogHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';
import TagCloud from '@/components/blog/TagCloud.astro';
import { getPosts, getTags, tagSlug } from '@/lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = getTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      tags,
      posts: posts.filter((p) => p.tags.some((t) => tagSlug(t) === tag.slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, tags, posts } = Astro.props;
---

<BaseLayout title={`#${tag.slug}`} description={`Blog posts tagged “${tag.name}”.`}>
  <BlogHeader
    prompt={`grep -l "${tag.slug}" ~/blog/*`}
    title={`#${tag.slug}`}
    description={`${posts.length} post${posts.length === 1 ? '' : 's'} tagged “${tag.name}”.`}
  />
  <div class="container-page py-10">
    <TagCloud tags={tags} active={tag.slug} />
    <div class="mt-6">
      {posts.map((post) => <PostCard post={post} variant="row" />)}
    </div>
  </div>
</BaseLayout>
