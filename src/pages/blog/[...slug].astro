---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { profile } from '@/lib/data';
import { resolveAsset } from '@/lib/images';
import { getPosts, formatDate, tagSlug, type Post } from '@/lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    // Posts are newest first: "newer" is the one before, "older" the one after.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Group each h3 under the h2 before it, so the TOC can collapse subsections.
type TocHeading = (typeof headings)[number];
const sections: { heading: TocHeading; children: TocHeading[] }[] = [];
for (const h of toc) {
  if (h.depth === 2 || !sections.length) sections.push({ heading: h, children: [] });
  else sections.at(-1)!.children.push(h);
}

const avatar = await getImage({ src: resolveAsset(profile.photo), width: 96, height: 96, format: 'webp' });
const url = new URL(`/blog/${post.slug}/`, Astro.site).toString();
const shareText = encodeURIComponent(post.title);
const shareUrl = encodeURIComponent(url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date.toISOString(),
  dateModified: (post.updated ?? post.date).toISOString(),
  author: { '@type': 'Person', name: post.author, url: Astro.site?.toString() },
  keywords: post.tags.join(', '),
  mainEntityOfPage: url,
  wordCount: post.words,
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={post.cover}
  imageAlt={post.coverAlt}
  type="article"
  published={post.date}
  modified={post.updated}
  tags={post.tags}
  jsonLd={jsonLd}
>
  <article class="pt-28" data-pagefind-body>
    <header class="container-page max-w-6xl">
      <div class="lg:max-w-3xl">
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
        data-pagefind-ignore
      >
        <Icon name="lucide:arrow-left" class="size-4" />
        cd ..
      </a>

      {
        post.tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2 font-mono text-xs" data-pagefind-ignore>
            {post.tags.map((tag) => (
              <li>
                <a
                  href={`/blog/tags/${tagSlug(tag)}/`}
                  class="rounded-full border border-border px-2.5 py-1 text-accent transition-colors hover:border-accent/50"
                  data-pagefind-filter="tag"
                >
                  #{tagSlug(tag)}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl" data-pagefind-meta="title">
        {post.title}
      </h1>
      {post.description && <p class="mt-5 text-lg text-muted text-pretty">{post.description}</p>}

      <div
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-border py-4 text-sm text-muted"
        data-pagefind-ignore
      >
        <span class="flex items-center gap-3">
          <img src={avatar.src} alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-1 ring-border" />
          <span class="font-medium text-fg">{post.author}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 font-mono text-xs">
          <Icon name="lucide:calendar" class="size-3.5" />
          <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        </span>
        {
          post.updated && (
            <span class="inline-flex items-center gap-1.5 font-mono text-xs">
              <Icon name="lucide:refresh-cw" class="size-3.5" />
              updated <time datetime={post.updated.toISOString()}>{formatDate(post.updated)}</time>
            </span>
          )
        }
        <span class="inline-flex items-center gap-1.5 font-mono text-xs">
          <Icon name="lucide:clock" class="size-3.5" />
          {post.minutes} min read · {post.words.toLocaleString()} words
        </span>
        {post.draft && <span class="rounded bg-amber-500/15 px-2 py-0.5 font-mono text-xs text-amber-500">draft</span>}
      </div>

      {
        post.cover && (
          <Image
            src={post.cover}
            alt={post.coverAlt ?? ''}
            widths={[640, 960, 1280]}
            sizes="(min-width: 896px) 896px, 100vw"
            class="mt-10 w-full rounded-2xl border border-border"
            loading="eager"
          />
        )
      }
      </div>
    </header>

    <div class="container-page mt-12 grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="prose-post prose prose-lg min-w-0 dark:prose-invert lg:max-w-3xl">
        <Content />
      </div>

      {
        toc.length > 1 && (
          <aside class="order-first lg:order-none" data-pagefind-ignore>
            <nav class="toc-shell lg:sticky lg:top-24" aria-label="Table of contents">
              <details class="card toc-card group" open>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 lg:pointer-events-none">
                  <span class="font-mono text-xs tracking-wider text-muted uppercase">
                    <span class="text-accent">#</span> On this page
                  </span>
                  <span class="flex items-center gap-2 font-mono text-xs text-muted">
                    <span id="toc-percent" class="tabular-nums">0%</span>
                    <Icon name="lucide:chevron-down" class="size-4 transition-transform group-open:rotate-180 lg:hidden" />
                  </span>
                </summary>
                <div class="toc-progress mt-3" aria-hidden="true">
                  <span id="toc-bar"></span>
                </div>

                <ol class="toc mt-4">
                  {sections.map((s, i) => (
                    <li class="toc-section" data-section={s.heading.slug}>
                      <a href={`#${s.heading.slug}`} data-toc={s.heading.slug} class="toc-link">
                        <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                        <span class="toc-text">{s.heading.text}</span>
                        {s.children.length > 0 && <span class="toc-count">{s.children.length}</span>}
                      </a>
                      {s.children.length > 0 && (
                        <div class="toc-sub">
                          <ol>
                          {s.children.map((c) => (
                            <li>
                              <a href={`#${c.slug}`} data-toc={c.slug} data-parent={s.heading.slug} class="toc-sublink">
                                {c.text}
                              </a>
                            </li>
                          ))}
                          </ol>
                        </div>
                      )}
                    </li>
                  ))}
                </ol>

                <a href="#top" id="toc-top" class="toc-top">
                  <Icon name="lucide:arrow-up" class="size-3.5" /> back to top
                </a>
              </details>
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="container-page mt-16 max-w-6xl" data-pagefind-ignore>
      <div class="lg:max-w-3xl">
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-8">
        <p class="font-mono text-sm text-muted">Share this post</p>
        <div class="flex items-center gap-2">
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-10 place-items-center rounded-lg border border-border text-muted transition-colors hover:border-accent/50 hover:text-accent"
            aria-label="Share on LinkedIn"
          >
            <Icon name="simple-icons:linkedin" class="size-4" />
          </a>
          <a
            href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-10 place-items-center rounded-lg border border-border text-muted transition-colors hover:border-accent/50 hover:text-accent"
            aria-label="Share on X"
          >
            <Icon name="simple-icons:x" class="size-4" />
          </a>
          <button
            type="button"
            id="copy-link"
            data-url={url}
            class="grid size-10 place-items-center rounded-lg border border-border text-muted transition-colors hover:border-accent/50 hover:text-accent"
            aria-label="Copy link"
          >
            <Icon name="lucide:link" class="size-4" />
          </button>
        </div>
      </div>

      <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="More posts">
        {
          older ? (
            <a href={`/blog/${older.slug}/`} class="card group p-5 transition-colors hover:border-accent/50">
              <span class="inline-flex items-center gap-1 font-mono text-xs text-muted">
                <Icon name="lucide:arrow-left" class="size-3.5" /> Older
              </span>
              <span class="mt-2 block font-semibold group-hover:text-accent">{older.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a href={`/blog/${newer.slug}/`} class="card group p-5 text-right transition-colors hover:border-accent/50">
              <span class="inline-flex items-center gap-1 font-mono text-xs text-muted">
                Newer <Icon name="lucide:arrow-right" class="size-3.5" />
              </span>
              <span class="mt-2 block font-semibold group-hover:text-accent">{newer.title}</span>
            </a>
          )
        }
      </nav>
      </div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .toc-card {
    padding: 1rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(10px);
  }
  @media (min-width: 1024px) {
    .toc-card .toc {
      max-height: calc(100vh - 16rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
      margin-right: -0.5rem;
      padding-right: 0.5rem;
    }
  }

  .toc-progress {
    height: 3px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .toc-progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transition: transform 0.15s linear;
  }

  .toc {
    position: relative;
    display: grid;
    gap: 0.125rem;
    font-size: 0.875rem;
  }
  .toc-link {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.4rem 0.5rem;
    border-radius: 0.5rem;
    color: var(--muted);
    line-height: 1.35;
    transition: color 0.15s, background-color 0.15s;
  }
  .toc-link:hover {
    color: var(--fg);
    background: var(--surface-2);
  }
  .toc-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .toc-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .toc-count {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .toc-section.is-open > .toc-link,
  .toc-link.is-active {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .toc-section.is-open .toc-num {
    color: var(--accent);
    opacity: 1;
  }
  .toc-section.is-read .toc-num {
    color: var(--accent);
  }

  /* Subsections stay folded until their section is being read. */
  .toc-sub {
    display: grid;
    grid-template-rows: 0fr;
    margin-left: 1.15rem;
    transition: grid-template-rows 0.25s ease, margin 0.25s ease;
  }
  .toc-sub > ol {
    min-height: 0;
    overflow: hidden;
    border-left: 1px solid var(--border);
  }
  .toc-section.is-open > .toc-sub {
    grid-template-rows: 1fr;
    margin-block: 0.25rem;
  }
  .toc-sublink {
    display: block;
    margin-left: -1px;
    /* Vertical spacing as margin: padding would reveal the clamped third line. */
    margin-block: 0.3rem;
    padding: 0 0.5rem 0 0.9rem;
    border-left: 2px solid transparent;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s, border-color 0.15s;
  }
  .toc-sublink:hover {
    color: var(--fg);
  }
  .toc-sublink.is-active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .toc-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    transition: color 0.15s;
  }
  .toc-top:hover {
    color: var(--accent);
  }
</style>

<script>
  const article = document.querySelector('.prose-post');

  // Clickable "#" anchor on every heading.
  article?.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((heading) => {
    const anchor = document.createElement('a');
    anchor.href = `#${heading.id}`;
    anchor.className = 'heading-anchor';
    anchor.textContent = '#';
    anchor.setAttribute('aria-label', `Link to "${heading.textContent}"`);
    heading.appendChild(anchor);
  });

  // Let readers tick Markdown task lists (they render disabled by default).
  article?.querySelectorAll<HTMLInputElement>('li > input[type="checkbox"][disabled]').forEach((box) => {
    box.disabled = false;
  });

  // Language label + copy button on code blocks.
  article?.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    const lang = document.createElement('span');
    lang.className = 'lang';
    lang.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = 'copy';
    button.setAttribute('aria-label', 'Copy code');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
        button.textContent = 'copied ✓';
      } catch {
        button.textContent = 'failed';
      }
      setTimeout(() => (button.textContent = 'copy'), 1600);
    });
    toolbar.append(lang, button);
    pre.prepend(toolbar);
  });

  // Table of contents: highlight the heading in view, unfold its section,
  // mark finished sections and show reading progress.
  const tocList = document.querySelector<HTMLElement>('.toc');
  const links = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.toc-section')];
  const targets = links
    .map((a) => ({ link: a, el: document.getElementById(a.dataset.toc!) }))
    .filter((t): t is { link: HTMLElement; el: HTMLElement } => !!t.el);
  const bar = document.getElementById('toc-bar');
  const percent = document.getElementById('toc-percent');
  let activeId = '';

  const update = () => {
    if (article) {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
      if (bar) bar.style.transform = `scaleX(${done})`;
      if (percent) percent.textContent = `${Math.round(done * 100)}%`;
    }

    let current = targets[0];
    for (const t of targets) {
      if (t.el.getBoundingClientRect().top <= 120) current = t;
      else break;
    }
    if (!current || current.link.dataset.toc === activeId) return;
    activeId = current.link.dataset.toc!;

    links.forEach((a) => a.classList.toggle('is-active', a === current.link));
    const sectionId = current.link.dataset.parent ?? activeId;
    let reached = false;
    for (const s of sections) {
      const isCurrent = s.dataset.section === sectionId;
      if (isCurrent) reached = true;
      s.classList.toggle('is-open', isCurrent);
      s.classList.toggle('is-read', !reached);
    }

    // Keep the active entry visible inside the scrollable TOC on desktop.
    if (tocList && tocList.scrollHeight > tocList.clientHeight) {
      const top = current.link.offsetTop;
      if (top < tocList.scrollTop || top > tocList.scrollTop + tocList.clientHeight - 40) {
        tocList.scrollTo({ top: top - tocList.clientHeight / 3, behavior: 'smooth' });
      }
    }
  };

  if (targets.length) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  // Copy post link.
  const copy = document.getElementById('copy-link');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.url ?? location.href);
      copy.classList.add('text-accent');
      setTimeout(() => copy.classList.remove('text-accent'), 1600);
    } catch {}
  });

  // Load interactive blog widgets (e.g. the agentic AI architecture diagram).
  if (document.getElementById('aw-svg')) {
    const s = document.createElement('script');
    s.src = '/js/agentic-ai-widget.js';
    document.body.appendChild(s);
  }
</script>
