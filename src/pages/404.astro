---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="404: Not found" description="This page does not exist.">
  <section class="container-page flex min-h-[80svh] flex-col items-center justify-center pt-24 text-center">
    <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> curl -I {Astro.url.pathname}</p>
    <h1 class="mt-4 font-mono text-7xl font-bold text-accent sm:text-8xl">404</h1>
    <p class="mt-4 max-w-md text-muted">
      HTTP/1.1 404 Not Found. This path doesn't exist, or it was moved. No vulnerability here, just a dead end.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-fg">
        <Icon name="lucide:house" class="size-4" /> Home
      </a>
      <a href="/blog/" class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-3 text-sm font-semibold hover:text-accent">
        <Icon name="lucide:book-open" class="size-4" /> Blog
      </a>
    </div>
  </section>
</BaseLayout>
